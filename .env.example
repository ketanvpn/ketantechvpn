# Copy file ini jadi `.env` lalu isi nilainya. Konfigurasi non-sensitif
# (tier bonus, scheduler, dll) tetap di `.vars.json`.

# Telegram
BOT_TOKEN=
USER_ID=
MASTER_ID=
ADMIN_IDS=
GROUP_ID=
BACKUP_CHAT_ID=

# Merchant / QRIS
NAMA_STORE=
DATA_QRIS=
MERCHANT_ID=
API_KEY=

# KetantechPay Gateway (recommended)
# Isi PAYMENT_GATEWAY_API_KEY dengan Client API Key dari dashboard KetantechPay.
# BotVPN harus lewat KetantechPay, bukan langsung ke AutoGoPay/OrderKuota.
PAYMENT_GATEWAY_BASE_URL=https://pay.ketantech.my.id
PAYMENT_GATEWAY_API_KEY=

# Legacy alias untuk kompatibilitas kode lama. Samakan dengan PAYMENT_GATEWAY_BASE_URL.
GOPAY_API_BASE_URL=https://pay.ketantech.my.id

# GoPay/AutoGopay legacy (fallback kalau belum migrasi ke KetantechPay)
GOPAY_API_KEY=
GOPAY_BASE_QR=
GOPAY_AUTH_USERNAME=
GOPAY_AUTH_TOKEN=
GOPAY_CREATEPAYMENT_URL=
GOPAY_CREATEPAYMENT_APIKEY=

# OrderKuota mutasi (legacy, masih dipakai sebagai fallback)
ORDERKUOTA_AUTH_USERNAME=
ORDERKUOTA_AUTH_TOKEN=
ORDERKUOTA_BASE_QR=
ORDERKUOTA_CREATEPAYMENT_URL=
ORDERKUOTA_CREATEPAYMENT_APIKEY=

# Cek mutasi endpoint
CEKPAY_API_URL=https://api.rajaserver.web.id/orderkuota/cekstatus
CEKPAY_ORKUT_USERNAME=
CEKPAY_ORKUT_TOKEN=

# Proxy SOCKS (JSON array string). Contoh: ["user:pass@host:1080"]
SOCKS_POOL=[]

# Runtime
PORT=6969
HTTP_BIND=127.0.0.1
TIME_ZONE=Asia/Jayapura
EXPIRE_DATE=2050-09-23
LOG_LEVEL=info
NODE_ENV=production