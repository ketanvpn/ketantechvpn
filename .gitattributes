# Semua text file di repo ini dipaksa LF (Unix-style), konsisten antara
# Windows dan Linux VPS. Ini menghindari "phantom changes" di git status
# gara-gara core.autocrlf auto-convert CRLF <-> LF.
*           text eol=lf

# File binary yang tidak boleh di-convert.
*.jpg       binary
*.jpeg      binary
*.png       binary
*.gif       binary
*.ico       binary
*.db        binary
*.tar       binary
*.tar.gz    binary
*.zip       binary
