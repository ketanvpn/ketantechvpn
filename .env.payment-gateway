# .env - Tambahkan variable ini untuk integrasi payment gateway
# Jangan commit API key asli ke repository. Isi nilai production langsung di VPS.

# ============================================
# PAYMENT GATEWAY KETANTECHPAY
# ============================================

# URL payment gateway kita sendiri
GOPAY_API_BASE_URL=https://pay.ketantech.my.id

# Client API key untuk autentikasi ke KetantechPay (/api/v1/payments/*)
# Ambil dari dashboard KetantechPay: System/Settings -> Client API Keys
PAYMENT_GATEWAY_API_KEY=isi_client_api_key_di_vps

# ============================================
# VARIABLE LAMA (OPSIONAL/FALLBACK)
# ============================================

# AutoGopay API key lama tidak perlu di bot kalau sudah lewat KetantechPay.
# Simpan API key AutoGopay hanya di dashboard KetantechPay credentials.
GOPAY_API_KEY=
